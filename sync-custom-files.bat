@echo off
rem Two-way sync for custom_files between this PC and the Pterodactyl server.
rem   1) Download plugin configs that exist only on the server (generated by plugins, pulled back on startup)
rem   2) Upload local changes (and delete remote files removed locally)
rem   3) Keep watching the local folder and upload every change until this window is closed (Ctrl+C)
rem Connection settings come from .env next to this file (not in git): copy .env.example to .env and fill it in.

if not exist "%~dp0.env" (
  echo .env not found. Copy .env.example to .env and fill it in.
  pause
  exit /b 1
)
rem KEY=VALUE lines, # starts a comment
for /f "usebackq eol=# tokens=1,* delims==" %%A in ("%~dp0.env") do set "%%A=%%B"

if not defined WINSCP_SESSION (
  echo WINSCP_SESSION is missing in .env.
  pause
  exit /b 1
)
if not defined WINSCP_PATH set "WINSCP_PATH=%LOCALAPPDATA%\Programs\WinSCP\WinSCP.com"

set "LOCAL=%~dp048b4a3c2-4508-40ba-974b-6fd0df07d518\custom_files"
set "REMOTE=/custom_files"
set "CFG=addons/counterstrikesharp/configs/plugins"

rem LocalDirectory override: the saved WinSCP site may still point to an old copy of this folder
rem (open fails with "Error changing directory" when that folder no longer exists).

"%WINSCP_PATH%" /command ^
  "open ""%WINSCP_SESSION%"" -rawsettings LocalDirectory=""%LOCAL%""" ^
  "synchronize local -criteria=none ""%LOCAL%\addons\counterstrikesharp\configs\plugins"" ""%REMOTE%/%CFG%""" ^
  "synchronize remote -delete ""%LOCAL%"" ""%REMOTE%""" ^
  "keepuptodate -delete ""%LOCAL%"" ""%REMOTE%"""

pause
