# Copy to .env (not in git) and fill in. Used by sync-custom-files.bat.
# KEY=VALUE, no spaces around =, no quotes.

# Name of the saved site in WinSCP (Login dialog). The password stays in WinSCP, not here.
WINSCP_SESSION=

# Optional: WinSCP.com path when it is not in %LOCALAPPDATA%\Programs\WinSCP
# WINSCP_PATH=C:\Program Files (x86)\WinSCP\WinSCP.com
