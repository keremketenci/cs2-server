# Ghost Territory CS2 server: only our own files go to git.
# Game files, downloads, backups (they contain player databases) and build outputs stay local.

# --- Server mirror: keep custom_files, the startup script and the egg configs, nothing else ---
/cs2-server/*
!/cs2-server/custom_files/
!/cs2-server/custom_files.sh
!/cs2-server/egg/
# empty placeholder files from the egg
/cs2-server/egg/grep
/cs2-server/egg/ls
# rewritten by the egg on every CSS / Metamod update (see PANEL.md)
/cs2-server/egg/versions.txt

# --- Local only ---
# Connection settings for sync-custom-files.bat (template: .env.example)
/.env
# SimpleAdmin database copies (player data), never upload
/backups/
# Release zips and logs, can be downloaded again
/downloads/
# kus/cs2-modded-server reference copy (third party, 650 MB)
/cs2-modded-server-1.0.56/
# Claude Code local settings
/.claude/

# --- Build outputs (only under build/: custom_files/addons/multiaddonmanager/bin is a real server folder) ---
/build/**/bin/
/build/**/obj/
/build/gmm-src.zip
/build/decompiled/
# ilspycmd dotnet tool, reinstall: dotnet tool install ilspycmd --version 9.* --tool-path build/tools/ilspy
/build/tools/ilspy/

# --- Databases and logs, wherever they are ---
*.db
*.db-journal
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.log

# --- Editor and OS ---
.vs/
.vscode/
.idea/
*.user
*.suo
Thumbs.db
desktop.ini
